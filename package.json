{
  "name": "booking-movie-ticket",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend/client",
    "backend"
  ],
  "scripts": {
    "dev:client": "npm run dev --workspace=frontend/client",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "concurrently -n client,backend -c cyan,yellow \"npm run dev:backend\" \"npm run dev:client\"",

    "build:client": "npm run build --workspace=frontend/client",
    "lint:client": "npm run lint --workspace=frontend/client"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
